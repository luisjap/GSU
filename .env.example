# PORT la inyecta Railway automáticamente; en local usa 3000 por defecto.

# ---- Base de datos (Railway → Postgres plugin) ----
# Railway inyecta esta variable automáticamente al agregar el plugin de
# Postgres al proyecto. Sin esta variable, /api/contact y /api/orders
# siguen funcionando (solo loguean en consola, no persisten).
# DATABASE_URL=

# ---- Servicio de email (futuro: conectar /api/contact) ----
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
